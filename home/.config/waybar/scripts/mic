#!/usr/bin/env bash
# Microphone mute status / toggle for Waybar (PipeWire via wpctl).
#   mic status | mic toggle
SIGNAL=9
case ${1:-status} in
  toggle)
    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    pkill -RTMIN+$SIGNAL -x waybar ;;
  status)
    if ! out=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null); then
      echo '{"text":""}'; exit 0
    fi
    if [[ $out == *MUTED* ]]; then
      echo '{"text":"󰍭","tooltip":"Microphone muted (click to unmute)","class":"muted"}'
    else
      echo '{"text":"󰍬","tooltip":"Microphone on (click to mute)","class":"on"}'
    fi ;;
esac
