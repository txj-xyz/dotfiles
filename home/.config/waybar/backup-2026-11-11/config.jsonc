{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 8,

  "modules-left": [
    "cpu",
    "memory"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "network",
    "pulseaudio",
    "tray"
  ],

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format": "RAM {}%"
  },

  "clock": {
    "format": "{:%I:%M %p}"
  },

  "network": {
    "format-wifi": "Wi-Fi {essid}",
    "format-ethernet": "Ethernet",
    "format-disconnected": "Offline"
  },

  "pulseaudio": {
    "format": "VOL {volume}%",
    "format-muted": "Muted"
  },

  "tray": {
    "spacing": 8
  }
}
